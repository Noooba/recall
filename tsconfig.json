{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "*.ts",
    ".next-midnight/types/**/*.ts",
    ".next-premium-build/types/**/*.ts",
    ".next-premium-dev/types/**/*.ts",
    ".next-premium-final/types/**/*.ts",
    ".next-premium-release/types/**/*.ts",
    ".next-premium-verified/types/**/*.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "next-env.d.ts",
    "tests/**/*.ts",
    ".next-midnight-final/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "docs",
    ".next-*"
  ]
}
